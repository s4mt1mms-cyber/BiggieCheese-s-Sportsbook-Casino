rules_version = '2';

// BiggieCheese's Sportsbook — Firestore security rules (Phase 1).
//
// MEMBERSHIP. You're "in" when links/{your Firebase uid} exists. That doc is
// created only by redeeming an unused invite code (invites/{code}) in the same
// batch that marks the invite used by you, or, for the bootstrap admin below,
// automatically on first sign-in. links/{uid}.oldId is your player id in the
// app (an old artifact id, or your own uid for a brand-new player).
//
// ADMINS: the bootstrap admin email below (keep in sync with
// public/js/firebase-shim.js), plus any member whose email is listed in
// config/admins.emails. Admins can write config/*, the commissioner-only
// collections (meta, adjust, cardimg), invites, links and anyone's prefs.
//
// PLAYER-OWNED docs (prefs/{id}, profiles/{id}, live/{id}): only that player or
// an admin can write. "That player" = links/{uid}.oldId. Every member can read
// them (live/{id} holds a player's table state so others can watch the game).
//
// LIVE TABLES. rrin/thin (moves), mpreq (lobby requests), mptick (deadline
// pokes) and rrlook (head looks) are player-owned like prefs. The table docs
// rrtable/thtable and the hole cards thhole/{gid}_{playerId}: while the game
// server is on (config/mp.serverHost == true and its heartbeat config/mp.beat
// is under 5 minutes old) only the Cloud Functions write them; otherwise a
// player's phone hosts and members may write them, as before. Either way you can
// read only your own hole cards. mpsecret (deck, everyone's cards) is server-only.
//
// DIRECT MESSAGES (dms/{a__b} and dms/{a__b}/msgs/*): only the two players in the
// pair id (sorted player ids joined by "__") can read or write them. Not even admins.
//
// EVERYTHING ELSE (bets, games, market, chat, bank, loans, plat, photos, media,
// ...) is read/write for any member — the same trust model the artifact had.
// Phase 2 moves money to Cloud Functions; see README "Roadmap".

service cloud.firestore {
  match /databases/{database}/documents {

    function bootstrapEmail() { return 's4mt1mms@gmail.com'; }
    function bootstrapOldId() { return 'u_IfmXeDmDg1B3W4naCzVbSA'; }

    function docPath(coll, id) {
      return /databases/$(database)/documents/$(coll)/$(id);
    }

    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function myLinkPath() {
      return docPath('links', request.auth.uid);
    }

    function member() {
      return signedIn() && exists(myLinkPath());
    }

    function isAdmin() {
      return signedIn() && (
        myEmail() == bootstrapEmail()
        || (exists(myLinkPath())
            && exists(docPath('config', 'admins'))
            && myEmail() in get(docPath('config', 'admins')).data.emails)
      );
    }

    // The player id this account plays as.
    function myPlayerId() {
      return get(myLinkPath()).data.oldId;
    }

    function isSelf(id) {
      return member() && myPlayerId() == id;
    }

    // Collections only admins may change (invites/links have their own rules below).
    function adminOnly(coll) {
      return coll in ['config', 'meta', 'adjust', 'cardimg', 'nfl'];
    }

    // One doc per player; only that player (or an admin) may change it.
    // live/{id}: the player's in-progress casino table (hand, shoe, last spin) plus
    // stats not yet copied into prefs; members read it to spectate.
    function playerOwned(coll) {
      return coll in ['prefs', 'profiles', 'live', 'rrin', 'thin', 'mpreq', 'mptick', 'rrlook'];
    }

    // Collections with their own match blocks below.
    function special(coll) {
      return coll in ['invites', 'links', 'config', 'rrtable', 'thtable', 'thhole', 'mpsecret', 'dms'];
    }

    // True while phones host the live tables (game server off, or not answering).
    function phoneHosting() {
      let p = docPath('config', 'mp');
      return !exists(p)
        || get(p).data.get('serverHost', false) != true
        || request.time.toMillis() - get(p).data.get('beat', 0) > 300000;
    }

    // ---------------------------------------------------------------
    // invites/{code}: made by admins. Anyone signed in may read ONE invite by its
    // code (not list them), and claim an unused one for themselves.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || claimInvite(code);
    }

    function claimInvite(code) {
      return signedIn()
        && resource.data.used == false
        && resource.data.get('revoked', false) != true
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['used', 'claimedBy', 'claimedEmail', 'claimedAt'])
        && request.resource.data.used == true
        && request.resource.data.claimedBy == request.auth.uid
        && request.resource.data.claimedEmail == myEmail()
        && request.resource.data.claimedAt is number
        // ...and the matching link doc is written in the same batch.
        && existsAfter(myLinkPath())
        && getAfter(myLinkPath()).data.code == code;
    }

    // ---------------------------------------------------------------
    // links/{uid}: your membership card. You can read your own; admins read all
    // and can remove access (delete). You can create your own exactly once, by
    // claiming an invite in the same batch (or as the bootstrap admin).
    match /links/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid && validNewLink();
      allow update: if false;
      allow delete: if isAdmin();
    }

    function validNewLink() {
      let d = request.resource.data;
      return d.keys().hasOnly(['oldId', 'email', 'code', 'at'])
        && d.email == myEmail()
        && d.oldId is string && d.oldId.size() > 0
        && d.code is string
        && (
          // bootstrap owner, straight to their old player
          (d.code == 'bootstrap' && myEmail() == bootstrapEmail() && d.oldId == bootstrapOldId())
          // or a real invite that was unused before this batch and is claimed by me after it
          || (d.code != 'bootstrap' && claimedNow(d.code, d.oldId))
        );
    }

    function claimedNow(code, oldId) {
      let before = get(docPath('invites', code)).data;
      let after = getAfter(docPath('invites', code)).data;
      return before.used == false
        && before.get('revoked', false) != true
        && after.used == true
        && after.claimedBy == request.auth.uid
        && oldId == (before.get('oldId', null) == null ? request.auth.uid : before.oldId);
    }

    // ---------------------------------------------------------------
    // config/*: members read (the app reads config/admins), admins write.
    match /config/{name} {
      allow read: if member() || isAdmin();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Live table state: everyone at the league can watch; only the host writes.
    match /{coll}/{docId} {
      allow read: if (member() || isAdmin()) && coll in ['rrtable', 'thtable'];
      allow write: if (member() || isAdmin()) && coll in ['rrtable', 'thtable'] && phoneHosting();
    }
    // Hole cards: thhole/{gid}_{playerId}, readable only by that player.
    match /thhole/{docId} {
      allow read: if member() && docId == docId.split('_')[0] + '_' + myPlayerId();
      allow write: if member() && phoneHosting();
    }
    // mpsecret/*: the server's deck and everyone's hole cards. Nobody else, ever.
    match /mpsecret/{docId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------
    // Direct messages. dms/{pairId}: pairId = the two player ids, sorted, joined
    // by "__"; the doc repeats them as a, b and ids [a, b] (for "my threads"
    // queries). Messages live in dms/{pairId}/msgs and must be from the writer.
    function dmIn(pairId) {
      let p = pairId.split('__');
      return member() && p.size() == 2 && p[0] < p[1]
        && (p[0] == myPlayerId() || p[1] == myPlayerId());
    }
    function validDm(pairId) {
      let p = pairId.split('__');
      let d = request.resource.data;
      return d.a == p[0] && d.b == p[1] && d.ids == [p[0], p[1]];
    }
    match /dms/{pairId} {
      allow get: if dmIn(pairId);
      allow list: if member() && myPlayerId() in resource.data.ids;
      allow create, update: if dmIn(pairId) && validDm(pairId);
      allow delete: if false;
    }
    match /dms/{pairId}/msgs/{msgId} {
      allow read: if dmIn(pairId);
      allow create: if dmIn(pairId)
        && request.resource.data.from == myPlayerId()
        && request.resource.data.at is number
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() <= 400000));
      // Either player may set/clear only their own reaction field r_<their id> (an emoji string or null).
      allow update: if dmIn(pairId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['r_' + myPlayerId()])
        && (request.resource.data['r_' + myPlayerId()] == null
            || (request.resource.data['r_' + myPlayerId()] is string && request.resource.data['r_' + myPlayerId()].size() <= 16));
      allow delete: if dmIn(pairId) && resource.data.from == myPlayerId();
    }

    // ---------------------------------------------------------------
    // Every other top-level document in the app.
    match /{coll}/{docId} {
      allow read: if (member() || isAdmin()) && !special(coll);

      allow create, update: if (member() || isAdmin()) && !special(coll) && (
        isAdmin()
        || (!adminOnly(coll) && !playerOwned(coll))
        || (playerOwned(coll) && isSelf(docId))
      ) && (coll != 'bets' || isAdmin() || nflBetOk());

      // Players never delete their own prefs/profile; admins can.
      allow delete: if (member() || isAdmin()) && !special(coll) && (
        isAdmin()
        || (!adminOnly(coll) && !playerOwned(coll))
      );
    }

    // NFL bets vs the House (gameId "nfl:{season}_{week}:{espnId}:{ml|sp|tot}", also as parlay legs).
    // They can only be placed before kickoff, per nfl/{season}_{week}.g[espnId].kick (written by the
    // hourly job), and once placed only an admin may change them (void/restore).
    function nflId(id) {
      return id is string && id.matches('nfl:.*');
    }
    function nflKickOk(id) {
      let p = id.split(':');
      return p.size() == 4
        && get(docPath('nfl', p[1])).data.g[p[2]].kick > request.time.toMillis();
    }
    function nflLegOk(legs, i) {
      return legs.size() <= i || !nflId(legs[i].gameId) || nflKickOk(legs[i].gameId);
    }
    function nflBetOk() {
      let d = request.resource.data;
      let wasNfl = resource != null && (nflId(resource.data.get('gameId', null)) || resource.data.get('nfl', null) == true);
      let legs = d.get('legs', null);
      return !wasNfl
        && (!nflId(d.get('gameId', null)) || nflKickOk(d.gameId))
        && (!(legs is list) || (
          (legs.size() <= 12 || d.get('nfl', null) != true)
          && nflLegOk(legs, 0) && nflLegOk(legs, 1) && nflLegOk(legs, 2) && nflLegOk(legs, 3)
          && nflLegOk(legs, 4) && nflLegOk(legs, 5) && nflLegOk(legs, 6) && nflLegOk(legs, 7)
          && nflLegOk(legs, 8) && nflLegOk(legs, 9) && nflLegOk(legs, 10) && nflLegOk(legs, 11)));
    }

    // No other subcollections; keep them closed.
    match /{coll}/{docId}/{rest=**} {
      allow read, write: if false;
    }
  }
}
